{
  "name": "btcnode",
  "version": "4.0.0",
  "private": true,
  "type": "module",
  "description": "Dashboard and control for a self-hosted Bitcoin full node",
  "license": "MIT",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "pnpm -r --filter ./shared --filter ./backend --filter ./frontend build",
    "dev": "pnpm -r --parallel --filter ./backend --filter ./frontend dev",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "e2e": "playwright test -c e2e/playwright.config.ts",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.65.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.12.1",
    "globals": "^16.5.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.2",
    "vue-eslint-parser": "^10.4.2"
  }
}
