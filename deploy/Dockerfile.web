# syntax=docker/dockerfile:1.7@sha256:a57df69d0ea827fb7266491f2813635de6f17269be881f696fbfdf2d83dda33e
# The page: nginx with the built frontend, TLS, and the /api proxy.
#   docker build -f deploy/Dockerfile.web -t btcnode-web .
#
# Base images are pinned by the digest of their multi-arch index (arm64 and
# amd64 alike); the tag stays beside it so a human knows what it is.

# node:22-bookworm-slim
FROM node:22-bookworm-slim@sha256:4b150b48b4116e2a22f2c39cc27025fbf4f153e2078fd3b14d159fdb5c7279da AS build
RUN corepack enable
WORKDIR /src
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml .npmrc ./
COPY shared/package.json shared/
COPY frontend/package.json frontend/
RUN --mount=type=cache,target=/root/.local/share/pnpm/store \
    pnpm install --frozen-lockfile --filter ./shared --filter ./frontend
COPY tsconfig.base.json ./
COPY shared/ shared/
COPY frontend/ frontend/
RUN pnpm --filter ./shared build && pnpm --filter ./frontend build

# nginx:1.30-alpine
FROM nginx:1.30-alpine@sha256:0e52bd054126cdc040b1276c0af347aeb02a41b9cfe305d6094767ac30e97949
COPY deploy/nginx/nginx.conf /etc/nginx/nginx.conf
COPY deploy/nginx/default.conf.template deploy/nginx/redirect.conf.template /etc/nginx/templates/
COPY --from=build /src/frontend/dist/ /usr/share/nginx/html/
ENV WEB_PORT=443 HTTP_PORT=80 API_UPSTREAM=127.0.0.1:3000
