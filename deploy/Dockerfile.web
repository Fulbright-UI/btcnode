# syntax=docker/dockerfile:1.7@sha256:a57df69d0ea827fb7266491f2813635de6f17269be881f696fbfdf2d83dda33e
# The page: nginx with the built frontend, TLS, and the /api proxy.
#   docker build -f deploy/Dockerfile.web -t btcnode-web .
#
# Base images are pinned by the digest of their multi-arch index (arm64 and
# amd64 alike); the tag stays beside it so a human knows what it is.

# node:26-bookworm-slim
FROM node:26-bookworm-slim@sha256:bc0a2afd3b74ce12222fc8bab99271e66257f021078f5f4a5d687a77d280c1d9 AS build
# pnpm in the version package.json names, checked by its sha256. Node ships
# without corepack from 25 on.
ADD --checksum=sha256:7e8a946108e7baab119e51d27c24d6178b46545422643dbc91e34e2f1ee32e0f \
    https://registry.npmjs.org/pnpm/-/pnpm-10.34.9.tgz /tmp/pnpm.tgz
RUN tar -xzf /tmp/pnpm.tgz -C /opt && mv /opt/package /opt/pnpm && rm /tmp/pnpm.tgz \
 && chmod +x /opt/pnpm/bin/pnpm.cjs && ln -s /opt/pnpm/bin/pnpm.cjs /usr/local/bin/pnpm
WORKDIR /src
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml .npmrc ./
COPY shared/package.json shared/
COPY frontend/package.json frontend/
RUN --mount=type=cache,target=/root/.local/share/pnpm/store \
    pnpm install --frozen-lockfile --filter ./shared --filter ./frontend
COPY tsconfig.base.json ./
COPY shared/ shared/
COPY frontend/ frontend/
RUN pnpm --filter ./shared build && pnpm --filter ./frontend build

# nginx:1.31-alpine
FROM nginx:1.31-alpine@sha256:785835ea65db4bba6f021acc0f3be91b0fef76a53fe41f8588c6698d2aed0606
# Alpine fixes land before the next nginx image does. apk.log carries the
# time of the upgrade and would make every build differ. The libxslt
# floor (CVE-2026-87636, CVE-2026-9947) also keeps the build cache from
# reusing an older upgrade layer.
RUN apk upgrade --no-cache \
    && apk add --no-cache --upgrade "libxslt>=1.1.43-r4" \
    && rm -f /var/log/apk.log
COPY deploy/nginx/nginx.conf /etc/nginx/nginx.conf
COPY deploy/nginx/default.conf.template deploy/nginx/redirect.conf.template /etc/nginx/templates/
COPY --from=build /src/frontend/dist/ /usr/share/nginx/html/
ENV WEB_PORT=443 HTTP_PORT=80 API_UPSTREAM=127.0.0.1:3000
