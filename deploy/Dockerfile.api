# syntax=docker/dockerfile:1.7@sha256:a57df69d0ea827fb7266491f2813635de6f17269be881f696fbfdf2d83dda33e
# The backend: collector, API, control. Built from the monorepo root:
#   docker build -f deploy/Dockerfile.api -t btcnode-api .
#
# Base images are pinned by the digest of their multi-arch index (arm64 and
# amd64 alike); the tag stays beside it so a human knows what it is.

# node:26-bookworm-slim
FROM node:26-bookworm-slim@sha256:bc0a2afd3b74ce12222fc8bab99271e66257f021078f5f4a5d687a77d280c1d9 AS build
# pnpm in the version package.json names, checked by its sha256. Node ships
# without corepack from 25 on.
ADD --checksum=sha256:7e8a946108e7baab119e51d27c24d6178b46545422643dbc91e34e2f1ee32e0f \
    https://registry.npmjs.org/pnpm/-/pnpm-10.34.9.tgz /tmp/pnpm.tgz
RUN tar -xzf /tmp/pnpm.tgz -C /opt && mv /opt/package /opt/pnpm && rm /tmp/pnpm.tgz \
 && chmod +x /opt/pnpm/bin/pnpm.cjs && ln -s /opt/pnpm/bin/pnpm.cjs /usr/local/bin/pnpm
WORKDIR /src
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml .npmrc ./
COPY shared/package.json shared/
COPY backend/package.json backend/
RUN --mount=type=cache,target=/root/.local/share/pnpm/store \
    pnpm install --frozen-lockfile --filter ./shared --filter ./backend
COPY tsconfig.base.json ./
COPY shared/ shared/
COPY backend/ backend/
# .modules.yaml is pnpm's bookkeeping with the time of the install; node
# does not read it, and without it the layer is the same on every build.
RUN pnpm --filter ./shared build && pnpm --filter ./backend build \
 && pnpm --filter ./backend deploy --prod --legacy /out \
 && rm /out/node_modules/.modules.yaml

# node:26-bookworm-slim
FROM node:26-bookworm-slim@sha256:bc0a2afd3b74ce12222fc8bab99271e66257f021078f5f4a5d687a77d280c1d9
# journalctl lives in the systemd package on Debian; it reads the host's
# journal files mounted read-only, nothing else of systemd runs here.
# npm is not needed at runtime and brings its own outdated dependencies.
# Logs, the ldconfig cache and the machine-id that systemd's postinst rolls
# differ on every build; an image should not carry a machine-id anyway.
# The upgrade pulls Debian security fixes the base image does not have yet.
RUN apt-get update \
 && apt-get upgrade -y --no-install-recommends \
 && apt-get install -y --no-install-recommends systemd ca-certificates \
 && rm -rf /var/lib/apt/lists/* \
 && rm -rf /usr/local/lib/node_modules/npm /usr/local/bin/npm /usr/local/bin/npx \
 && rm -rf /var/log/apt/* /var/log/dpkg.log /var/log/alternatives.log \
    /var/cache/ldconfig/aux-cache /etc/machine-id
WORKDIR /app
COPY --from=build --chown=node:node /out/ ./
ENV NODE_ENV=production HOST=127.0.0.1 PORT=3000
# node; install.sh makes the secrets readable for this gid
USER 1000:1000
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s \
  CMD ["node", "-e", "fetch('http://127.0.0.1:'+process.env.PORT+'/api/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"]
CMD ["node", "dist/index.js"]
