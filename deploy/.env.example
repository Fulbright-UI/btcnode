# Copy to .env and edit. scripts/install.sh writes this file for you.

# Shown in the header and page title
HOSTNAME=btcnode

# Ports. HTTPS on WEB_PORT, HTTP_PORT only redirects there.
WEB_PORT=443
HTTP_PORT=80
API_PORT=3000

# Bitcoin Core RPC (the password itself lives in secrets/rpc_password)
BITCOIN_RPC_URL=http://127.0.0.1:8332/
BITCOIN_RPC_USER=dashboard
BITCOIN_DATA_DIR=/mnt/bitcoin/bitcoin

# Electrum server
ELECTRUM_PORT=50001
ELECTRS_METRICS_URL=http://127.0.0.1:4224/

# Clocks (seconds)
STATUS_INTERVAL=21
LOG_INTERVAL=3
LOG_LINES=150

# Log source: the systemd journal of LOG_UNITS, or Core's own debug.log in
# BITCOIN_DATA_DIR ("file") — for a bitcoind that runs in a container.
LOG_SOURCE=journal
LOG_UNITS=bitcoind

# Where the host keeps its journal: /var/log/journal (persistent) or /run/log/journal (volatile)
JOURNAL_DIR=/var/log/journal

# Host group ids the api container joins — `getent group systemd-journal btcnode`
JOURNAL_GID=
AGENT_GID=
# With LOG_SOURCE=file: the group that may read debug.log (`stat -c %g <datadir>/debug.log`)
DATA_GID=

# Weekly version check (through Tor when the proxy answers)
UPDATE_CHECK=true
UPDATE_CHECK_TOR_PROXY=socks5h://127.0.0.1:9050

LOG_LEVEL=info
